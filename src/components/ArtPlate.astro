---
import { Image } from "astro:assets";

interface Props {
  /** Tritone artwork from src/assets/art (baked by scripts/prepare-art.mjs). */
  src: ImageMetadata;
  /** Artwork credit, used as alt text. */
  alt: string;
  widths?: number[];
  sizes?: string;
  /** Focal point for object-position, e.g. "50% 30%". */
  focus?: string;
  /** Load eagerly (above-the-fold plates). */
  priority?: boolean;
  /**
   * Parallax travel as a fraction of the plate height (see parallax.ts), or
   * false to disable. The image overscans by the same amount plus a margin,
   * so it never exposes the plate edge.
   */
  parallax?: number | false;
  /** AVIF quality; lower it on full-width bands to keep them under ~300KB. */
  quality?: number;
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 800, 1200],
  sizes = "100vw",
  focus = "50% 50%",
  priority = false,
  parallax = 0.2,
  quality = 40,
  class: className,
} = Astro.props;
---

<figure
  class:list={["art-plate", className]}
  data-parallax={parallax ? String(parallax) : undefined}
  style={parallax ? `--overscan: ${parallax + 0.02}` : undefined}
>
  <div class="art-motion">
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
      format="avif"
      quality={quality}
      style={`object-position: ${focus}`}
    />
  </div>
  <slot />
</figure>

<style>
  /*
   * The art is baked tritone (scripts/prepare-art.mjs). It is served as AVIF,
   * which sharp encodes at 4:4:4 chroma, so thin neon lines stay sharp.
   */
  .art-plate {
    position: relative;
    overflow: clip;
    isolation: isolate;
    background: var(--art-field);
    color: var(--art-text);
    /* Framed panel, matching the page frame and nav divider. Full-bleed
       bands are trimmed by the page frame's mat, so only their top and
       bottom edges show, meeting the frame's vertical lines. */
    border: 1px solid var(--color-frame);
  }

  /* Parallax moves this wrapper, not the filtered img, so the browser can
     keep the filtered image as a cached layer while scrolling. */
  .art-motion {
    position: absolute;
    left: 0;
    top: calc(var(--overscan, 0) * -100%);
    width: 100%;
    height: calc(100% + var(--overscan, 0) * 200%);
    transform: translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }

  .art-plate:not([data-parallax]) .art-motion {
    top: 0;
    height: 100%;
    will-change: auto;
  }

  .art-motion :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Heavier grain on the plates themselves */
  .art-plate::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 160px;
    mix-blend-mode: plus-lighter;
    opacity: 0.3;
  }

  /* Slotted content (e.g. band text) sits above the art and grain.
     Children set their own position. */
  .art-plate > :global(:not(.art-motion)) {
    z-index: 3;
  }
</style>
