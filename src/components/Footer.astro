---
import SocialLinks from "./SocialLinks.astro";
import ArtPlate from "./ArtPlate.astro";
import ramelli from "../assets/art/ramelli.webp";

const currentYear = new Date().getFullYear();
---

<footer class="rule-top">
  <div class="footer-main">
    <p class="wordmark" aria-hidden="true">Tranduc</p>
    <div class="footer-row">
      <p>&copy; {currentYear} Anthony Tranduc</p>
      <SocialLinks size={18} />
      <p class="credits">
        <a href="https://github.com/Antranduc/antranduc.github.io/blob/main/src/assets/art/CREDITS.md">
          Art credits
        </a>
      </p>
      <p class="inspired">Design inspired by the Nous Research website</p>
    </div>
  </div>
  <div class="bleed rule-top rule-bottom">
    <ArtPlate
      src={ramelli}
      alt="Agostino Ramelli, water mill with gear train, Le diverse et artificiose machine, 1588"
      widths={[800, 1200, 1500, 1800]}
      sizes="calc(100vw - 32px)"
      quality={30}
      focus="50% 45%"
      class="footer-plate"
    />
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-main {
    position: relative;
    padding: var(--spacing-3xl) 0 var(--spacing-xl);
    overflow: hidden;
  }

  /* Giant ghosted wordmark behind the footer row, as on the Hermes footer */
  .wordmark {
    position: absolute;
    left: 50%;
    bottom: -0.18em;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 20rem);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--color-text);
    opacity: 0.06;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .footer-row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md) var(--spacing-xl);
  }

  p {
    margin: 0;
  }

  .credits {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }


  /* Quiet footnote, one step below the other footer meta */
  .inspired {
    flex-basis: 100%;
    font-size: 0.75rem;
    opacity: 0.6;
  }

  .credits a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .credits a:hover {
    color: var(--color-accent-primary);
  }

  footer :global(.footer-plate) {
    height: clamp(12rem, 35vw, 26rem);
  }
</style>
