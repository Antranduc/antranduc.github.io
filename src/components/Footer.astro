---
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
---

<footer>
  <p>&copy; {currentYear} Anthony Tranduc</p>
  <SocialLinks size={18} />
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  p {
    margin: 0;
  }
</style>
