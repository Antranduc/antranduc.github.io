---
import Layout from "../layouts/Layout.astro";
import ArtPlate from "../components/ArtPlate.astro";
import { Image, getImage } from "astro:assets";
import { getPhotos } from "../lib/photos";
import lute from "../assets/art/lute.webp";

const photos = await Promise.all(
  getPhotos().map(async ({ image, addedAt }) => {
    const full = await getImage({
      src: image,
      width: Math.min(image.width, 1600),
    });
    return { image, addedAt, fullSrc: full.src };
  })
);
---

<Layout title="Photos | Anthony Tranduc" description="Photos by Anthony Tranduc">
  <header class="photos-header">
    <div>
      <p class="eyebrow">Ricoh GR III</p>
      <h1>Pictures <em>I Took</em></h1>
    </div>
    <ArtPlate
      src={lute}
      alt="Albrecht Dürer, The Draughtsman of the Lute, 1525"
      widths={[400, 700, 1000]}
      sizes="(min-width: 900px) 40vw, 100vw"
      focus="45% 35%"
      priority
      class="header-plate"
    />
  </header>

  {
    photos.length === 0 ? (
      <p class="empty">No photos yet.</p>
    ) : (
      <div class="photo-grid">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="photo-tile"
            data-full={photo.fullSrc}
            data-index={i}
            aria-label={`Open photo ${i + 1}`}
          >
            <Image
              src={photo.image}
              alt=""
              widths={[320, 480, 640]}
              sizes="(min-width: 640px) 33vw, 50vw"
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    )
  }

  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="lightbox-close" aria-label="Close">✕</button>
    <button type="button" class="lightbox-prev" aria-label="Previous photo">‹</button>
    <img class="lightbox-img" alt="" />
    <button type="button" class="lightbox-next" aria-label="Next photo">›</button>
  </dialog>
</Layout>

<script>
  const tiles = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".photo-tile")
  );
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  const img = document.querySelector<HTMLImageElement>(".lightbox-img");
  const closeBtn = document.querySelector<HTMLButtonElement>(".lightbox-close");
  const prevBtn = document.querySelector<HTMLButtonElement>(".lightbox-prev");
  const nextBtn = document.querySelector<HTMLButtonElement>(".lightbox-next");

  if (dialog && img && closeBtn && prevBtn && nextBtn && tiles.length > 0) {
    let current = 0;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const src = tiles[current].dataset.full;
      if (src) img.src = src;
    };

    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        show(Number(tile.dataset.index));
        dialog.showModal();
      });
    });

    closeBtn.addEventListener("click", () => dialog.close());
    prevBtn.addEventListener("click", () => show(current - 1));
    nextBtn.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowLeft") show(current - 1);
      else if (e.key === "ArrowRight") show(current + 1);
    });
  }
</script>

<style>
  .photos-header {
    display: grid;
    gap: var(--spacing-xl);
    align-items: end;
    margin-bottom: var(--spacing-2xl);
  }

  .photos-header .eyebrow {
    margin-bottom: var(--spacing-md);
  }

  .photos-header :global(.header-plate) {
    height: clamp(10rem, 25vw, 18rem);
  }

  @media (min-width: 900px) {
    .photos-header {
      grid-template-columns: 1fr 1fr;
    }
  }

  .empty {
    color: var(--color-text-muted);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--spacing-sm);
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--spacing-md);
    }
  }

  .photo-tile {
    all: unset;
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 5px;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-border);
    transition: transform 0.15s ease;
  }

  .photo-tile:hover,
  .photo-tile:focus-visible {
    transform: scale(1.02);
  }

  .photo-tile:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .photo-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 5px;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 1.5rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--color-accent-primary);
  }

  .lightbox-close {
    top: var(--spacing-md);
    right: var(--spacing-md);
    font-size: 1.1rem;
  }

  .lightbox-prev {
    left: var(--spacing-md);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: var(--spacing-md);
    top: 50%;
    transform: translateY(-50%);
  }
</style>
