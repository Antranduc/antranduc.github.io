---
import Layout from "../layouts/Layout.astro";
import { Image, getImage } from "astro:assets";
import { execFileSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

type PhotoModule = { default: ImageMetadata };

const photoModules = import.meta.glob<PhotoModule>(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}",
  { eager: true }
);

const currentDir = path.dirname(fileURLToPath(import.meta.url));

function getAddedAt(filePath: string): number {
  try {
    const out = execFileSync(
      "git",
      ["log", "-1", "--format=%ct", "--", filePath],
      { encoding: "utf8" }
    ).trim();
    if (out) return parseInt(out, 10) * 1000;
  } catch {
    // git not available or file not tracked — fall through
  }
  try {
    return fs.statSync(filePath).mtimeMs;
  } catch {
    return 0;
  }
}

const photos = await Promise.all(
  Object.entries(photoModules).map(async ([relativePath, mod]) => {
    const image = mod.default;
    const absPath = path.resolve(currentDir, relativePath);
    const addedAt = getAddedAt(absPath);
    const full = await getImage({
      src: image,
      width: Math.min(image.width, 1600),
    });
    return { image, addedAt, fullSrc: full.src };
  })
);

photos.sort((a, b) => b.addedAt - a.addedAt);
---

<Layout title="Photos | Anthony Tranduc" description="Photos by Anthony Tranduc">
  <header class="photos-header">
    <h1>Pictures I Took</h1>
    <p class="subtitle">Ricoh GR III</p>
  </header>

  {
    photos.length === 0 ? (
      <p class="empty">No photos yet.</p>
    ) : (
      <div class="photo-grid">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="photo-tile"
            data-full={photo.fullSrc}
            data-index={i}
            aria-label={`Open photo ${i + 1}`}
          >
            <Image
              src={photo.image}
              alt=""
              widths={[320, 480, 640]}
              sizes="(min-width: 640px) 33vw, 50vw"
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    )
  }

  <dialog class="lightbox" aria-label="Photo viewer">
    <button type="button" class="lightbox-close" aria-label="Close">✕</button>
    <button type="button" class="lightbox-prev" aria-label="Previous photo">‹</button>
    <img class="lightbox-img" alt="" />
    <button type="button" class="lightbox-next" aria-label="Next photo">›</button>
  </dialog>
</Layout>

<script>
  const tiles = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".photo-tile")
  );
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  const img = document.querySelector<HTMLImageElement>(".lightbox-img");
  const closeBtn = document.querySelector<HTMLButtonElement>(".lightbox-close");
  const prevBtn = document.querySelector<HTMLButtonElement>(".lightbox-prev");
  const nextBtn = document.querySelector<HTMLButtonElement>(".lightbox-next");

  if (dialog && img && closeBtn && prevBtn && nextBtn && tiles.length > 0) {
    let current = 0;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const src = tiles[current].dataset.full;
      if (src) img.src = src;
    };

    tiles.forEach((tile) => {
      tile.addEventListener("click", () => {
        show(Number(tile.dataset.index));
        dialog.showModal();
      });
    });

    closeBtn.addEventListener("click", () => dialog.close());
    prevBtn.addEventListener("click", () => show(current - 1));
    nextBtn.addEventListener("click", () => show(current + 1));

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    document.addEventListener("keydown", (e) => {
      if (!dialog.open) return;
      if (e.key === "ArrowLeft") show(current - 1);
      else if (e.key === "ArrowRight") show(current + 1);
    });
  }
</script>

<style>
  .photos-header {
    margin-bottom: var(--spacing-xl);
  }

  .photos-header h1 {
    margin-bottom: var(--spacing-xs);
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .empty {
    color: var(--color-text-muted);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--spacing-sm);
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--spacing-md);
    }
  }

  .photo-tile {
    all: unset;
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 5px;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-border);
    transition: transform 0.15s ease;
  }

  .photo-tile:hover,
  .photo-tile:focus-visible {
    transform: scale(1.02);
  }

  .photo-tile:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
  }

  .photo-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-img {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 5px;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--color-accent-primary);
  }

  .lightbox-close {
    top: var(--spacing-md);
    right: var(--spacing-md);
    font-size: 1.1rem;
  }

  .lightbox-prev {
    left: var(--spacing-md);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: var(--spacing-md);
    top: 50%;
    transform: translateY(-50%);
  }
</style>
