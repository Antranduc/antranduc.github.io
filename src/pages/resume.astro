          </li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <h2>Education</h2>

    <div class="entry">
      <div class="entry-header">
        <div>
          <h3>Tufts University</h3>
          <p class="org">Medford, MA</p>
        </div>
        <span class="date">Class of 2022</span>
      </div>
      <p class="degree">
        BS in Computer Science, Second Major in Philosophy
      </p>
      <p class="org">
        GPA 3.82/4.00 &middot; Summa Cum Laude &middot; Phi Beta Kappa
      </p>
    </div>
