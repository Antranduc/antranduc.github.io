---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Resume | Anthony Tranduc" description="Anthony Tranduc's Resume">
  <div class="page-header">
    <h1>Resume</h1>
    <a href="/AnthonyTranduc-Resume.pdf" class="pdf-link" target="_blank" rel="noopener">
      &gt; View as PDF
    </a>
  </div>

  <section>
    <h2>Work Experience</h2>

    <div class="entry">
      <div class="entry-header">
        <div>
          <h3>Amazon Robotics</h3>
          <p class="org">Boston, MA</p>
        </div>
        <span class="date">Aug 2022 &ndash; Present</span>
      </div>
      <div class="role">
        <div class="role-header">
          <span>Software Development Engineer II</span>
          <span class="date">Apr 2024 &ndash; Present</span>
        </div>
        <ul>
          <li>
            Lead two engineers building a controls-in-the-loop simulator on
