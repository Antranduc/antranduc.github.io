</Layout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--spacing-2xl);
  }

  h1 {
    margin-bottom: 0;
  }

  .pdf-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .pdf-link:hover {
    color: var(--color-accent-primary);
    text-decoration: none;
  }

  section {
    margin-bottom: var(--spacing-2xl);
  }

  h2 {
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .entry {
    margin-bottom: var(--spacing-xl);
  }

  .entry:last-child {
    margin-bottom: 0;
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-xs);
  }

  h3 {
    margin-bottom: 0;
  }

  .org {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .entry p {
    margin-bottom: var(--spacing-xs);
    line-height: 1.6;
  }

  .degree {
    font-weight: 600;
    margin-top: var(--spacing-sm);
  }



  .entry ul {
    margin: var(--spacing-sm) 0;
    padding-left: var(--spacing-lg);
    list-style: none;
  }

  .entry ul li {
    color: var(--color-text);
    line-height: 1.8;
    position: relative;
    padding-left: 1.25rem;
  }

  .entry ul li::before {
    content: ">";
    position: absolute;
    left: 0;
    color: var(--color-accent-primary);
    font-weight: 700;
  }

  .skills {
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
    margin-bottom: var(--spacing-xs);
  }

  .skills dd {
    margin: 0 0 var(--spacing-md);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .skills dd:last-child {
    margin-bottom: 0;
  }

  .role {
    padding-left: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .role:last-child {
    margin-bottom: 0;
  }

  /* Accent bar spans only the title line, not the bullets below it. */
  .role-header {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-xs) 0;
  }

  .role-header::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--spacing-md));
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent-primary);
  }

  .role-header span:first-child {
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .entry-header {
      flex-direction: column;
      gap: var(--spacing-xs);
    }

    .role-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-xs);
    }
  }
</style>
